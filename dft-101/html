<script>
(function(){


const $=h=>{const d=document.createElement('div');d.innerHTML=h;return d.firstElementChild};
const css=n=>getComputedStyle(document.getElementById('pd-root')).getPropertyValue(n).trim();
const rng=s=>()=>(s=(s*1664525+1013904223)>>>0)/4294967296;
const shuf=(a,r)=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
function cv(w,h){const c=document.createElement('canvas'),d=devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.maxWidth=w+'px';c.x=c.getContext('2d');c.x.scale(d,d);return c}
function sl(lab,min,max,step,v,cb,fmt=v=>v){const d=$(`<label class="pdsl"><span>${lab}</span><input type="range" min="${min}" max="${max}" step="${step}" value="${v}"><b></b></label>`),i=d.querySelector('input'),o=d.querySelector('b');const f=()=>{o.textContent=fmt(+i.value);cb(+i.value)};i.oninput=f;f();return d}
function btn(t,fn,alt){const b=$(`<button class="pdb${alt?' alt':''}">${t}</button>`);b.onclick=fn;return b}
const rowOf=(...e)=>{const r=$('<div class="pdrow"></div>');e.forEach(x=>r.append(x));return r};

/* 1 Why DFT: escapes vs coverage */
function l1(b){const c=cv(320,150),m=$('<div class="pdm"></div>');let Y=.8,FC=.95;
 const dl=(y,f)=>(1-Math.pow(y,1-f))*1e6;
 function draw(){const x=c.x,top=dl(Y,.8)||1;x.clearRect(0,0,320,150);x.strokeStyle=css('--line');x.lineWidth=1;x.beginPath();x.moveTo(30,120);x.lineTo(300,120);x.moveTo(30,15);x.lineTo(30,120);x.stroke();
  x.strokeStyle=css('--a');x.lineWidth=2;x.beginPath();for(let i=0;i<=40;i++){const f=.8+.2*i/40,px=30+270*i/40,py=120-dl(Y,f)/top*100;i?x.lineTo(px,py):x.moveTo(px,py)}x.stroke();
  x.fillStyle=css('--w');x.beginPath();x.arc(30+270*(FC-.8)/.2,120-dl(Y,FC)/top*100,5,0,6.3);x.fill();
  x.fillStyle=css('--mut');x.font='11px system-ui';x.textAlign='center';x.fillText('80%',30,136);x.fillText('fault coverage',165,146);x.fillText('100%',300,136);x.textAlign='left';x.fillText('escapes (DPPM)',36,22);
  const d=dl(Y,FC);m.innerHTML=`Escapes: about <b style="color:${css(d>1000?'--w':'--ok')}">${Math.round(d).toLocaleString()} DPPM</b> (bad chips shipped per million) at ${Math.round(Y*100)}% yield and ${(FC*100).toFixed(1)}% coverage. Automotive customers expect single digits.`}
 b.append(c,m,sl('Process yield',50,95,1,80,v=>{Y=v/100;draw()},v=>v+'%'),sl('Fault coverage',80,100,.1,95,v=>{FC=v/100;draw()},v=>v.toFixed(1)+'%'));
 b.append($('<p class="pdm">Uses the Williams–Brown model: escapes = 1 − yield<sup>(1 − coverage)</sup>. Low-yield processes need much higher coverage to ship the same quality.</p>'));
}

/* 3 Stuck-at faults */
function l3(b){const m=$('<div class="pdm"></div>'),NM=['a','b','c','n1 (a AND b)','y'];let site=3,sv=0;
 const ev=(a,e,f,fs)=>{const v={a,b:e,c:f};if(fs===0)v.a=sv;if(fs===1)v.b=sv;if(fs===2)v.c=sv;let n1=v.a&v.b;if(fs===3)n1=sv;let y=n1|v.c;if(fs===4)y=sv;return y};
 function draw(){let rows='',det=0;for(let i=0;i<8;i++){const a=i>>2&1,e=i>>1&1,f=i&1,g=ev(a,e,f,-1),h=ev(a,e,f,site),d=g!==h;if(d)det++;rows+=`<tr style="border-top:1px solid ${css('--line')};${d?'font-weight:600':''}"><td>${a}${e}${f}</td><td align=center>${g}</td><td align=center>${h}</td><td style="color:${css(d?'--ok':'--mut')}">${d?'✓ detects':'–'}</td></tr>`}
  m.innerHTML=`Circuit: y = (a AND b) OR c · fault: <b>${NM[site]} stuck-at-${sv}</b><table style="width:100%;border-collapse:collapse;font-size:14px;margin:8px 0"><tr style="color:${css('--mut')}"><th align=left>a b c</th><th>good y</th><th>faulty y</th><th align=left>result</th></tr>${rows}</table><b>${det}</b> of 8 vectors detect this fault. A vector must <b>activate</b> the fault (drive the net to the opposite value) and <b>propagate</b> its effect to an output.`}
 b.append(m,sl('Fault site',0,4,1,3,v=>{site=v;draw()},v=>NM[v].split(' ')[0]),rowOf(btn('Toggle stuck-at-0 / stuck-at-1',()=>{sv=1-sv;draw()})));
}

/* 4 Scan chain */
function l4(b){const c=cv(320,170),m=$('<div class="pdm"></div>');let Q,si,p,cyc,out,mode,seed=3;
 const fn=q=>[q[1]^q[2],q[0]&q[3],q[2]|q[0],q[1]^q[3]];
 function init(){const r=rng(seed);si=Array.from({length:16},()=>r()<.5?1:0);Q=[0,0,0,0];p=0;cyc=0;out=[];mode='reset';draw()}
 function shift(){out.push(Q[3]);Q=[si[p%16],Q[0],Q[1],Q[2]];p++;cyc++;mode='shift (SE=1)'}
 function draw(){const x=c.x;x.clearRect(0,0,320,170);x.textAlign='center';x.font='13px system-ui';
  Q.forEach((q,i)=>{const bx=60+i*62;x.strokeStyle=css('--mut');x.lineWidth=1.5;x.fillStyle=css(q?'--a':'--cell');x.fillRect(bx,60,44,44);x.strokeRect(bx,60,44,44);x.fillStyle=q?'#ffffff':css('--fg');x.fillText(q,bx+22,87);x.fillStyle=css('--mut');x.font='11px system-ui';x.fillText('FF'+(i+1),bx+22,120);x.font='13px system-ui';
   if(i){x.strokeStyle=css('--b');x.beginPath();x.moveTo(bx-18,82);x.lineTo(bx,82);x.stroke()}});
  x.fillStyle=css('--b');x.fillText('SI='+si[p%16],28,86);x.fillText('SO='+Q[3],300,86);
  x.fillStyle=css('--fg');x.fillText('SE = '+(mode.startsWith('shift')?1:0)+'  (each flop has a mux: D or scan-in)',160,30);
  m.innerHTML=`Mode: <b>${mode}</b> · clock cycles: <b>${cyc}</b><br>Scan-out so far: <b>${out.join('')||'–'}</b> · next pattern bits waiting: <b>${Array.from({length:6},(_,k)=>si[(p+k)%16]).join('')}…</b>`}
 b.append(c,m,rowOf(btn('Shift 1 clock',()=>{shift();draw()}),btn('Shift 4 clocks',()=>{for(let i=0;i<4;i++)shift();draw()}),btn('Capture 1 clock',()=>{Q=fn(Q);cyc++;mode='capture (SE=0)';draw()}),btn('New pattern',()=>{seed=Math.floor(Math.random()*999)+1;init()},1)));
 b.append($('<p class="pdm">Shift four times to load a pattern, capture once so the functional logic produces a response, then shift again to unload it. The unload overlaps the next pattern’s load, so each extra pattern costs about one chain length of clocks.</p>'));
 init();
}

/* 5 Scan DRC checklist */
function l5(b){const I=[['Clock driven by internal logic, not a pin',18,'add a test-mode mux so the tester controls it'],['Async reset driven by functional logic',6,'gate it so it stays inactive in test'],['ICG enable not forced on in test',12,'OR the enable with test_enable'],['Latch that stays opaque',3,'make it transparent in test mode'],['Tri-state bus that can fight',2,'force one driver on in test']],fx=I.map(()=>0),cov=$('<div class="pdm"></div>');
 const rows=I.map((it,i)=>{const r=btn('',()=>{fx[i]^=1;upd()},1);r.style.cssText='display:block;width:100%;text-align:left;margin:4px 0';return r});
 function upd(){rows.forEach((r,i)=>{r.innerHTML=(fx[i]?'✓ Fixed: ':'✗ ')+I[i][0]+' <span style="opacity:.7">— '+(fx[i]?I[i][2]:'costs up to '+I[i][1]+'% coverage')+'</span>'});
  const loss=I.reduce((a,it,i)=>a+(fx[i]?0:it[1]),0);cov.innerHTML=`Achievable scan coverage: <b style="color:${css(loss>10?'--w':'--ok')}">${100-loss}%</b> · violations left: <b>${fx.filter(v=>!v).length}</b><br>Scan DRC fails when test can’t control or observe a flop, so those flops drop out of the chain or can’t be tested. (Losses are simplified and added together.)`}
 b.append(...rows,cov);upd();
}

/* 6 Lock-up latch */
function l6(b){const c=cv(320,130),m=$('<div class="pdm"></div>');let T=2,sk=.5,lk=0;
 function draw(){const x=c.x,S=60,x0=20,hold=.3+(lk?T/2:0)-.05-sk;x.clearRect(0,0,320,130);
  const wave=(y,s,col)=>{x.strokeStyle=css(col);x.lineWidth=2;x.beginPath();let pv=null;for(let t=0;t<=4;t+=.01){const lv=((((t-s)%T)+T)%T)<T/2?1:0,py=y-(lv?22:0);if(pv===null)x.moveTo(x0+t*S,py);else{if(py!==pv)x.lineTo(x0+t*S,pv);x.lineTo(x0+t*S,py)}pv=py}x.stroke()};
  wave(50,0,'--a');wave(105,sk,'--b');x.fillStyle=css('--mut');x.font='11px system-ui';x.textAlign='left';x.fillText('launch clock',x0,14);x.fillText('capture clock (later by skew)',x0,69);
  const arr=.3+(lk?T/2:0);x.strokeStyle=css(hold<0?'--w':'--ok');x.lineWidth=2;x.setLineDash([4,3]);x.beginPath();x.moveTo(x0+arr*S,20);x.lineTo(x0+arr*S,120);x.stroke();x.setLineDash([]);
  x.fillStyle=css(hold<0?'--w':'--ok');x.fillText('new data arrives',Math.min(x0+arr*S+4,220),30);
  m.innerHTML=`Hold slack = clk→Q 0.30 ${lk?'+ half-cycle latch delay ':''}− hold 0.05 − skew = <b style="color:${css(hold<0?'--w':'--ok')}">${hold.toFixed(2)} ns ${hold<0?'· VIOLATED: data races through':'· met'}</b>`}
 b.append(c,m,sl('Clock skew',0,1,.05,.5,v=>{sk=v;draw()},v=>v.toFixed(2)+' ns'),sl('Clock period',1,4,.5,2,v=>{T=v;draw()},v=>v.toFixed(1)+' ns'),rowOf(btn('Toggle lock-up latch',()=>{lk=1-lk;draw()})));
 b.append($('<p class="pdm">When scan chains cross between clock domains, skew can make the next flop capture the new bit instead of the old one. A lock-up latch holds the data for half a cycle, restoring the hold margin without slowing the shift clock.</p>'));
}

/* 7 Clock staggering and test power */
function l7(b){const c=cv(320,150),m=$('<div class="pdm"></div>');let G=1;
 function draw(){const x=c.x,pk=100/G;x.clearRect(0,0,320,150);x.strokeStyle=css('--line');x.beginPath();x.moveTo(20,125);x.lineTo(305,125);x.stroke();
  for(let g=0;g<G;g++){const bx=30+g*(270/G),w=Math.min(24,250/G);x.fillStyle=css(pk>40?'--w':'--ok');x.fillRect(bx,125-pk,w,pk)}
  x.strokeStyle=css('--a');x.setLineDash([5,4]);x.beginPath();x.moveTo(20,85);x.lineTo(305,85);x.stroke();x.setLineDash([]);
  x.fillStyle=css('--a');x.font='11px system-ui';x.textAlign='left';x.fillText('IR-drop safe limit',24,80);x.fillStyle=css('--mut');x.fillText('time →  (each bar is one group of flops switching)',24,142);
  m.innerHTML=`Peak switching current: <b style="color:${css(pk>40?'--w':'--ok')}">${Math.round(pk)}%</b> of the unstaggered case · time spread: <b>${((G-1)*.2).toFixed(1)} ns</b> · lock-up latches needed: <b>${G-1}</b>`}
 b.append(c,m,sl('Staggered groups',1,8,1,1,v=>{G=v;draw()},v=>v));
 b.append($('<p class="pdm">If every scan flop toggles on the same shift edge, the surge can drop the supply and corrupt the test. Staggering the clock into groups spreads that current out, at the price of extra lock-up latches and a longer clock tree.</p>'));
}

/* 8 Test time and compression */
function l8(b){const m=$('<div class="pdm"></div>');let F=2e6,CH=1000,IO=16,P=8000;
 const t=cy=>{const s=cy/1e8;return s<1?(s*1e3).toFixed(0)+' ms':s<120?s.toFixed(1)+' s':(s/60).toFixed(1)+' min'},bits=x=>x>1e9?(x/1e9).toFixed(1)+' Gbit':(x/1e6).toFixed(0)+' Mbit';
 function draw(){const L=F/CH,L0=F/IO,c1=P*(L+1),c0=P*(L0+1),v1=P*IO*L*2,v0=P*IO*L0*2;
  m.innerHTML=`<table style="width:100%;border-collapse:collapse;font-size:14px"><tr style="color:${css('--mut')}"><th align=left></th><th align=right>No compression</th><th align=right>With CODEC</th></tr>`+
  `<tr style="border-top:1px solid ${css('--line')}"><td>Chain length</td><td align=right>${Math.round(L0).toLocaleString()}</td><td align=right><b>${Math.round(L).toLocaleString()}</b></td></tr>`+
  `<tr style="border-top:1px solid ${css('--line')}"><td>Test time at 100 MHz shift</td><td align=right>${t(c0)}</td><td align=right><b style="color:${css('--ok')}">${t(c1)}</b></td></tr>`+
  `<tr style="border-top:1px solid ${css('--line')}"><td>Tester data</td><td align=right>${bits(v0)}</td><td align=right><b style="color:${css('--ok')}">${bits(v1)}</b></td></tr></table>Compression ratio: <b>${(CH/IO).toFixed(0)}×</b> (${CH.toLocaleString()} internal chains fed by ${IO} tester channels)`}
 b.append(m,sl('Scan flops',.1,10,.1,2,v=>{F=v*1e6;draw()},v=>v.toFixed(1)+' M'),sl('Internal chains',100,2000,100,1000,v=>{CH=v;draw()},v=>v),sl('Tester channels',4,64,4,16,v=>{IO=v;draw()},v=>v),sl('Patterns',2000,20000,1000,8000,v=>{P=v;draw()},v=>v.toLocaleString()));
 b.append($('<p class="pdm">Test time is patterns × (chain length + 1) clocks. A decompressor/compressor (CODEC) lets a few tester pins drive many short internal chains. Real compression raises the pattern count a little and loses some diagnosis detail; this model keeps patterns fixed.</p>'));
}

/* 9 Test points */
function l9(b){const m=$('<div class="pdm"></div>');let N=10,K=6,cp=0,op=0;
 function draw(){const p1=cp?.5:Math.pow(.5,N),ob=op?1:Math.pow(.5,K),p=p1*ob,need=p>=1?1:Math.log(.05)/Math.log(1-p);
  const f=v=>v<1e-3?v.toExponential(1):v.toFixed(3);
  m.innerHTML=`Chance a random pattern sets the net to 1: <b>${f(p1)}</b> ${cp?'(control point forces it in test)':''}<br>Chance the effect reaches an output: <b>${f(ob)}</b> ${op?'(observation point captures it)':''}<br>Random patterns for 95% confidence of catching a stuck-at-0: <b style="color:${css(need>1e5?'--w':need>1e3?'--a':'--ok')}">${Math.ceil(need).toLocaleString()}</b>`}
 const cb=btn('',()=>{cp^=1;ub()},1),ob=btn('',()=>{op^=1;ub()},1);
 function ub(){cb.textContent=(cp?'✓':'+')+' Control point';ob.textContent=(op?'✓':'+')+' Observation point';draw()}
 b.append(m,sl('AND fan-in feeding the net',2,20,1,10,v=>{N=v;draw()},v=>v),sl('Logic depth to an output',0,12,1,6,v=>{K=v;draw()},v=>v),rowOf(cb,ob));ub();
 b.append($('<p class="pdm">A net driven by a wide AND is almost always 0, so random patterns rarely test it (poor <b>controllability</b>). A net buried under many gates rarely shows up at an output (poor <b>observability</b>). Test points add a tiny cell to fix either problem.</p>'));
