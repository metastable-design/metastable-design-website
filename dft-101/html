.pd .pdb,.pd .pdpg button{background:var(--a);color:#fff;border:1px solid var(--a);border-radius:8px;padding:8px 16px;font:500 14px var(--sans);cursor:pointer}
.pd .pdb.alt,.pd .pdpg button.alt{background:#fff;color:var(--fg);border-color:var(--line)}
