/* 10 Transition faults at speed */
function l10(b){const c=cv(320,120),m=$('<div class="pdm"></div>'),D=1.3,ts=.1;let T=3,dd=.4;
 function draw(){const x=c.x,S=60,x0=30,arr=D+dd+ts,det=arr>T;x.clearRect(0,0,320,120);
  x.fillStyle=css('--b');x.fillRect(x0,40,D*S,26);x.fillStyle=css('--w');x.fillRect(x0+D*S,40,dd*S,26);x.fillStyle=css('--mut');x.fillRect(x0+(D+dd)*S,40,ts*S,26);
  x.strokeStyle=css(det?'--ok':'--w');x.lineWidth=2;x.setLineDash([5,4]);x.beginPath();x.moveTo(x0+T*S,25);x.lineTo(x0+T*S,85);x.stroke();x.setLineDash([]);
  x.fillStyle=css('--fg');x.font='11px system-ui';x.textAlign='left';x.fillText('launch',x0,20);x.fillText('nominal path 1.3 ns',x0,82);x.fillText('defect delay',x0+D*S,98);x.fillStyle=css(det?'--ok':'--w');x.fillText('capture edge',Math.min(x0+T*S+4,240),20);
  m.innerHTML=`Data needs <b>${arr.toFixed(2)} ns</b> (path + defect + setup); capture edge at <b>${T.toFixed(1)} ns</b> → <b style="color:${css(det?'--ok':'--w')}">${det?'FAIL seen: defective chip rejected':'passes: the slow defect ESCAPES'}</b>`}
 const s=sl('Capture clock period',1,4,.1,3,v=>{T=v;draw()},v=>v.toFixed(1)+' ns'),st=(v)=>{const i=s.querySelector('input');i.value=v;i.oninput()};
 b.append(c,m,s,sl('Defect extra delay',0,1.5,.1,.4,v=>{dd=v;draw()},v=>v.toFixed(1)+' ns'),rowOf(btn('At-speed capture (1.5 ns)',()=>st(1.5)),btn('Slow stuck-at clock (4 ns)',()=>st(4),1)));
 b.append($('<p class="pdm">A transition fault is a gate that is slow to rise or fall. Scan tests launch a transition, then capture one functional clock later (launch-on-capture or launch-on-shift). Capturing with a slow clock lets a small extra delay hide; path-delay faults target specific long paths the same way.</p>'));
}

/* 11 MBIST and MARCH C- */
function l11(b){const c=cv(320,150),m=$('<div class="pdm"></div>'),N=8,F=['No fault','Cell 3 stuck-at-1','Cell 5 stuck-at-0','Cell 2 cannot rise (0→1)','Writing 1 to cell 1 flips cell 6'],
 EL=[['u',['w0']],['u',['r0','w1']],['u',['r1','w0']],['d',['r0','w1']],['d',['r1','w0']],['d',['r0']]],NM=['⇑(w0)','⇑(r0,w1)','⇑(r1,w0)','⇓(r0,w1)','⇓(r1,w0)','⇓(r0)'],ops=[];
 EL.forEach(([d,o],e)=>{const a=[...Array(N).keys()];if(d==='d')a.reverse();a.forEach(ad=>o.forEach(op=>ops.push({e,ad,op})))});
 let f=0,mem,pc,fail;
 function init(){mem=Array(N).fill(0);if(f===1)mem[3]=1;pc=0;fail=null;draw()}
 function step(){if(pc>=ops.length)return;const o=ops[pc++],v=+o.op[1];
  if(o.op[0]==='w'){const old=mem[o.ad];let w=v;if(f===3&&o.ad===2&&v===1)w=old;mem[o.ad]=w;if(f===1&&o.ad===3)mem[3]=1;if(f===2&&o.ad===5)mem[5]=0;if(f===4&&o.ad===1&&old===0&&v===1)mem[6]^=1}
  else if(mem[o.ad]!==v&&!fail)fail={o,got:mem[o.ad]}}
 function draw(){const x=c.x,cur=pc?ops[pc-1]:null;x.clearRect(0,0,320,150);x.textAlign='center';x.font='13px system-ui';
  mem.forEach((v,i)=>{const bx=12+i*37;x.fillStyle=css(v?'--a':'--cell');x.fillRect(bx,40,32,40);x.strokeStyle=css(cur&&cur.ad===i?'--w':'--mut');x.lineWidth=cur&&cur.ad===i?3:1;x.strokeRect(bx,40,32,40);x.fillStyle=v?'#ffffff':css('--fg');x.fillText(v,bx+16,65);x.fillStyle=css('--mut');x.font='11px system-ui';x.fillText('addr '+i,bx+16,96);x.font='13px system-ui'});
  NM.forEach((n,e)=>{x.fillStyle=css(cur&&cur.e===e?'--a':'--mut');x.fillText(n,32+e*52,128)});x.fillStyle=css('--mut');x.font='11px system-ui';x.fillText('MARCH C− elements',160,18);
  m.innerHTML=`Operation <b>${pc} / ${ops.length}</b>${cur?` · <b>${cur.op}</b> at address ${cur.ad}`:''}<br>`+(fail?`<b style="color:${css('--ok')}">Fault detected</b>: a read expected ${fail.o.op[1]} at address ${fail.o.ad} but got ${fail.got} (element ${NM[fail.o.e]})`:pc>=ops.length?(f?`<b style="color:${css('--w')}">Fault ESCAPED</b>`:`<b style="color:${css('--ok')}">Memory passed</b>`):'Step through the test…')}
 b.append(c,m,sl('Injected fault',0,4,1,0,v=>{f=v;init()},v=>F[v]),rowOf(btn('Step',()=>{step();draw()}),btn('Run all',()=>{while(pc<ops.length)step();draw()}),btn('Reset',init,1)));
 b.append($('<p class="pdm">MBIST wraps each memory with a small controller that writes and reads patterns on its own. MARCH C− sweeps the addresses up and down, reading back what it wrote, which exposes stuck-at, transition and coupling faults. Chips can use one shared controller for many memories or a separate controller per memory, trading area against test time and routing.</p>'));
}

/* 13 Quiz */
function l13(b){const Q=[
 ['A net is stuck-at-0. To detect it, a test must…',['Drive it to 1 and make that value visible at an output','Drive it to 0 and observe it','Toggle the clock at speed'],0,'Activation needs the opposite value, and propagation makes the difference observable.'],
 ['A 1,000-flop chain is split into 10 equal chains. Shift time per pattern falls to about…',['1,000 clocks','100 clocks','10 clocks'],1,'Each chain now has 100 flops, so loading takes about 100 shifts.'],
 ['What does a lock-up latch fix?',['Setup violations on the functional path','Hold violations when a scan chain crosses clock domains','Missing scan flops'],1,'It delays the data by half a cycle so the next flop cannot catch the new bit too early.'],
 ['Which fault model needs an at-speed capture clock?',['Stuck-at','Transition','Bridging only'],1,'A slow-to-rise or slow-to-fall gate only fails if the capture happens at functional speed.'],
 ['A net sits under a 12-deep chain of gates and is rarely seen at an output. The best fix is…',['A control point','An observation point','A wider clock tree'],1,'Observability is the problem, so capture the net in a test flop.'],
 ['What does MARCH C− do?',['Sweeps addresses up and down, writing and reading to expose memory faults','Shifts data through scan chains','Measures leakage current'],0,'It is a fixed read/write sequence run by MBIST hardware.']];
 let i=0,sc=0,done=0;const box=$('<div></div>');
 function show(){done=0;if(i>=Q.length){box.innerHTML=`<p><b>Score: ${sc} / ${Q.length}</b></p>`;box.append(btn('Try again',()=>{i=0;sc=0;show()}));return}
  const q=Q[i],bs=[],fb=$('<div class="pdm"></div>');box.innerHTML=`<p><b>${i+1}. ${q[0]}</b></p>`;
  q[1].forEach((o,k)=>{const bt=btn(o,()=>{if(done)return;done=1;if(k===q[2])sc++;bs.forEach((x,j)=>{x.style.background=j===q[2]?css('--ok'):j===k?css('--w'):'';x.style.color=j===q[2]||j===k?'#fff':''});fb.innerHTML=(k===q[2]?'Correct. ':'Not quite. ')+q[3];box.append(btn(i<Q.length-1?'Next question':'See score',()=>{i++;show()}))},1);bt.style.cssText+='display:block;width:100%;text-align:left;margin:6px 0';bs.push(bt);box.append(bt)});box.append(fb)}
 b.append(box);show();
}

const L=[
 {ch:'Foundations',t:'Why DFT?',fn:l1,tx:'<p>Chips are tested on automatic test equipment, but you can’t probe the billions of nodes inside one. <b>Design for Test (DFT)</b> adds structures that let a tester control and observe internal state, so manufacturing defects are caught before chips ship. Better coverage means fewer bad chips in customers’ hands.</p>'},
 {ch:'Foundations',t:'Defects & fault models',tx:'<p>Real <b>defects</b> are physical: opens, shorts, bridges between wires, weak vias, particles. Testers can’t chase each one, so DFT uses abstract <b>fault models</b>:</p><ul><li><b>Stuck-at:</b> a net is permanently 0 or 1.</li><li><b>Transition:</b> a gate is slow to rise or slow to fall.</li><li><b>Path delay:</b> a whole path is too slow.</li><li><b>Bridging:</b> two neighbouring nets are shorted, so an aggressor corrupts a victim.</li><li><b>IDDQ:</b> a defect makes the idle chip draw extra leakage current.</li></ul><p>Stuck-at is the workhorse; the other models catch what it misses.</p>'},
 {ch:'Fault models',t:'Stuck-at faults',fn:l3,tx:'<p>Pick a net on a tiny circuit and a stuck value, then see which input vectors expose it. Notice that some vectors detect several faults at once, which is why ATPG tools can cover millions of faults with far fewer patterns.</p>'},
 {ch:'Scan design',t:'Scan chains',fn:l4,tx:'<p>In <b>scan design</b> every flip-flop gets a mux so that, in test mode (<b>SE=1</b>), flops link into a shift register. The tester shifts a pattern in, pulses the clock once in functional mode to <b>capture</b> the logic’s response, then shifts the result out. This turns a hard sequential problem into a simple combinational one.</p>'},
 {ch:'Scan design',t:'Making logic scannable',fn:l5,tx:'<p>Scan <b>design rule checks</b> find structures that block control or observation of flops. Typical culprits are internally generated clocks, uncontrolled asynchronous resets, clock-gating enables that switch off flops in test mode, and opaque latches. Each unfixed violation removes flops, and the logic behind them, from test.</p>'},
 {ch:'Scan design',t:'Clock domains & lock-up latches',fn:l6,tx:'<p>A scan chain often crosses between flops on different clocks. If the receiving clock arrives later than the launching clock plus its clk→Q delay, the next flop captures the <b>new</b> bit instead of the old one: a hold violation in shift mode. A <b>lock-up latch</b> placed between the two retimes the data by half a cycle.</p>'},
 {ch:'Scan design',t:'Clock staggering & test power',fn:l7,tx:'<p>During shift, thousands of flops can toggle on the same edge, drawing far more current than functional mode ever does. That surge causes IR drop that can fail good chips. <b>Clock staggering</b> offsets the shift clock between groups of flops so their switching is spread over time.</p>'},
 {ch:'ATPG & compression',t:'Test time & compression',fn:l8,tx:'<p><b>ATPG</b> (automatic test pattern generation) creates the patterns. Every pattern costs a full chain length of shift clocks, so long chains mean long, expensive tester time. Compression and more chains cut that cost.</p>'},
 {ch:'ATPG & compression',t:'Test point insertion',fn:l9,tx:'<p>Some logic resists random patterns, such as wide ANDs, deep reconvergent cones and rarely-enabled paths. <b>Control points</b> force a net to a chosen value in test mode; <b>observation points</b> copy a net into a scan flop. A few of them can remove thousands of patterns.</p>'},
 {ch:'At-speed test',t:'Transition & path delay faults',fn:l10,tx:'<p>Some defects don’t break logic, they slow it down. Catching them means capturing at the chip’s real clock speed. The capture clock comes from the on-chip PLL, so pulses are fast even though shifting is slow.</p>'},
 {ch:'Memory test',t:'MBIST & MARCH tests',fn:l11,tx:'<p>Memories are dense, hold most of a chip’s transistors and are too big to scan. Instead each gets <b>memory built-in self-test (MBIST)</b>. Inject a fault and step through <b>MARCH C−</b> to see exactly which read catches it.</p>'},
 {ch:'Practice',t:'Test modes & constraints',tx:'<p>DFT needs its own timing constraints, one set per <b>mode</b>:</p><ul><li><b>Shift:</b> slow clock (tens of MHz), SE=1. Hold fixing matters most.</li><li><b>Stuck-at capture:</b> SE=0, usually a slow capture clock.</li><li><b>At-speed capture:</b> SE=0, functional-speed PLL pulses, full setup timing.</li></ul><p>The scan-enable is a high-fanout signal that switches between modes, so it is usually constrained as a case-analysis or false path and buffered separately. Memory BIST and boundary scan add their own modes.</p>'},
 {ch:'Practice',t:'Test yourself',fn:l13,tx:'<p>Six quick questions covering the whole course.</p>'}
];
