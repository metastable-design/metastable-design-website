.pd .pdflow{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}
.pd .pdflow span{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:13px}
.pd .pdflow span:not(:last-child)::after{content:" \2192";color:var(--a)}
