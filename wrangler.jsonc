{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metastable-design-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "vars": {
    "RAZORPAY_KEY_ID": "PUT_YOUR_NEW_ROTATED_KEY_ID_HERE",
    "STORE_NOTIFICATION_EMAIL": "metastable@metastable-design.org"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
