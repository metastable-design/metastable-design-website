<style>
/* VLSI 101 drop-down in the main menu */
.nav-dd{position:relative;display:inline-block}
.nav-dd-caret{font-size:.7em;margin-left:3px}
.nav-dd .nav-dd-menu{display:none;position:fixed;top:0;left:0;min-width:210px;background:#fff;border:1px solid #e1e6ec;border-radius:10px;box-shadow:0 8px 24px rgba(15,23,32,.12);padding:6px;z-index:1000;text-align:left;transform:none}
.nav-dd.open .nav-dd-menu{display:block}
.nav-dd .nav-dd-menu a{display:block;padding:8px 12px;border-radius:6px;white-space:nowrap;margin:0;color:#0f1720}
.nav-dd .nav-dd-menu a:hover{background:#f6f8fa}
.nav-dd .nav-dd-menu a.active{font-weight:600}
</style>
